{
  "id": "AegisErrorDlq04",
  "name": "AegisFlow — Sanitized dead-letter handler",
  "active": false,
  "nodes": [
    {
      "id": "workflow-error",
      "name": "Workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "parameters": {},
      "position": [
        0,
        0
      ],
      "typeVersion": 1
    },
    {
      "id": "prepare-sanitized-callback",
      "name": "Prepare sanitized callback",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const crypto=require('crypto');function sign(payload){const rawBody=JSON.stringify(payload);const timestamp=String(Math.floor(Date.now()/1000));return {rawBody,timestamp,signature:crypto.createHmac('sha256',$env.AEGIS_WEBHOOK_SECRET).update(timestamp+'.'+rawBody).digest('hex')};}const data=$input.first().json;const id=data.patient_uuid||data.execution?.customData?.patient_uuid;if(!/^[a-f0-9-]{36}$/i.test(id||''))return [];return [{json:sign({patient_uuid:id,status:'TRIAGE_FAILED_MANUAL_REVIEW',error_message:'WORKFLOW_FAILED_MANUAL_REVIEW'})}];"
      },
      "position": [
        240,
        0
      ],
      "typeVersion": 2
    },
    {
      "id": "send-dead-letter-callback",
      "name": "Send dead-letter callback",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTJS_INTERNAL_URL + \"/api/webhooks/n8n-callback\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-aegis-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "x-aegis-timestamp",
              "value": "={{ $json.timestamp }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {
          "timeout": 30000
        }
      },
      "position": [
        480,
        0
      ],
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    }
  ],
  "connections": {
    "Workflow error": {
      "main": [
        [
          {
            "node": "Prepare sanitized callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare sanitized callback": {
      "main": [
        [
          {
            "node": "Send dead-letter callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  }
}
