    },
    {
      "id": "sign-crm-sync",
      "name": "Sign CRM sync",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const crypto=require('crypto');function sign(payload){const rawBody=JSON.stringify(payload);const timestamp=String(Math.floor(Date.now()/1000));return {rawBody,timestamp,signature:crypto.createHmac('sha256',$env.AEGIS_WEBHOOK_SECRET).update(timestamp+'.'+rawBody).digest('hex')};}return [{json:sign({patient_uuid:$('Prepare intake').first().json.patient_uuid,stage:'APPROVED'})}];"
      },
      "position": [
        1100,
        0
      ],
      "typeVersion": 2
    },
    {
      "id": "update-hubspot",
      "name": "Update HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
