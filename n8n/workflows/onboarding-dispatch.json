{
  "id": "AegisOnboardingDispatch02",
  "name": "AegisFlow — Clinician approval and Gmail blind dispatch",
  "nodes": [
    {
      "id": "signed-webhook",
      "name": "Signed webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "aegis-onboarding-dispatch",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
