      {
        "parameters": {
          "jsCode": "// Verify HMAC & prepare Blind Notification Dispatch request (ADR-001)\nconst crypto = require('crypto');\nconst body = $input.first().json.body || $input.first().json;\n\nconst notifyPayload = {\n  patient_uuid: body.patient_uuid,\n  template: 'ONBOARDING_MAGIC_LINK',\n  onboarding_url: body.onboarding_url\n};\n\nconst rawBody = JSON.stringify(notifyPayload);\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst secret = $env.AEGIS_WEBHOOK_SECRET || 'aegis-dev-hmac-webhook-secret-key-2026';\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\n\nreturn [{\n  json: {\n    patient_uuid: body.patient_uuid,\n    hubspot_deal_stage: 'Approved - Onboarding Sent',\n    rawBody,\n    signature,\n    timestamp\n  }\n}];"
        },
        "id": "wf2-node-02",
        "name": "02. HubSpot Deal Stage -> Approved & Sign Blind Notify",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-340, -80]
      },
      {
        "parameters": {
