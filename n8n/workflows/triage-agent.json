        "jsCode": "const crypto=require('crypto');function sign(payload){const rawBody=JSON.stringify(payload);const timestamp=String(Math.floor(Date.now()/1000));return {rawBody,timestamp,signature:crypto.createHmac('sha256',$env.AEGIS_WEBHOOK_SECRET).update(timestamp+'.'+rawBody).digest('hex')};}const intake=$('Prepare intake').first().json;const result=$input.first().json.output;const triage=typeof result==='string'?JSON.parse(result):result;return [{json:sign({patient_uuid:intake.patient_uuid,status:'AI_TRIAGED',ai_triage:triage})}];"
