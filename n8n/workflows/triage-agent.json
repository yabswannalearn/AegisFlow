    {
      "id": "verify-hmac",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const crypto=require('crypto');const item=$input.first();const headers=item.json.headers||{};const rawBody=(await this.helpers.getBinaryDataBuffer(0,'data')).toString('utf8');const timestamp=headers['x-aegis-timestamp'];const signature=headers['x-aegis-signature'];let authorized=false;let body;try{body=JSON.parse(rawBody);if(/^\\d+$/.test(timestamp||'')&&/^[a-f0-9]{64}$/i.test(signature||'')&&Math.abs(Date.now()/1000-Number(timestamp))<=300){const expected=crypto.createHmac('sha256',$env.AEGIS_WEBHOOK_SECRET).update(timestamp+'.'+rawBody).digest();authorized=crypto.timingSafeEqual(Buffer.from(signature,'hex'),expected);}if(!/^[a-f0-9-]{36}$/i.test(body.patient_uuid||''))authorized=false;}catch{}return [{json:{authorized,request:authorized?body:{}}}];"
      },
      "position": [
        220,
        0
      ],
      "typeVersion": 2
    },
