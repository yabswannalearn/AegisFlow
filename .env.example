# Run npm run env:init to generate local secrets. Never commit .env.
POSTGRES_USER="aegis"
POSTGRES_PASSWORD="REPLACE_POSTGRES_PASSWORD"
POSTGRES_DB="aegis"
DATABASE_URL="postgresql://aegis:REPLACE_POSTGRES_PASSWORD@localhost:5434/aegis?schema=public"

PHI_ENCRYPTION_KEY="REPLACE_64_HEX_CHARACTERS"
AEGIS_WEBHOOK_SECRET="REPLACE_WEBHOOK_SECRET"
AEGIS_TOOL_API_KEY="REPLACE_TOOL_SECRET"
JWT_RBAC_SECRET="REPLACE_JWT_SECRET"
AEGIS_WORKER_SECRET="REPLACE_WORKER_SECRET"
N8N_ENCRYPTION_KEY="REPLACE_N8N_SECRET"

# Synthetic portfolio demo. Demo clinician sign-in is disabled unless true.
AEGIS_DEMO_MODE="true"
AEGIS_OUTBOX_WORKER="true"
AEGIS_CRM_MODE="live"
DEMO_SIMULATE_N8N_IF_SLEEPING="false"
NEXT_PUBLIC_APP_URL="http://localhost:3005"
# Optional public-origin override for reverse proxies; Compose sets this.
AEGIS_ALLOWED_ORIGIN="http://localhost:3005"
N8N_TRIAGE_WEBHOOK_URL="http://localhost:5679/webhook/aegis-triage"
N8N_ONBOARDING_DISPATCH_WEBHOOK_URL="http://localhost:5679/webhook/aegis-onboarding-dispatch"
N8N_ONBOARDING_COMPLETE_WEBHOOK_URL="http://localhost:5679/webhook/aegis-onboarding-complete"

# n8n stores the Gemini API key; only its credential reference belongs here.
N8N_GEMINI_CREDENTIAL_ID="SELECT_GEMINI_CREDENTIAL"
N8N_GEMINI_CREDENTIAL_NAME="Google Gemini(PaLM) Api account"
GEMINI_MODEL="models/gemini-3.1-flash-lite"

# npm run crm:setup writes these IDs after creating the dedicated pipeline.
HUBSPOT_PRIVATE_APP_TOKEN=""
HUBSPOT_PIPELINE_ID=""
HUBSPOT_STAGE_TRIAGED=""
HUBSPOT_STAGE_APPROVED=""
HUBSPOT_STAGE_ONBOARDED=""
HUBSPOT_STAGE_EMERGENCY=""

# Gmail replaces Resend. Leave recipient empty for an email-free public demo.
# Live dispatch uses refresh_token, not a short-lived access token.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_ACCESS_TOKEN=""
GMAIL_TEST_RECIPIENT=""
