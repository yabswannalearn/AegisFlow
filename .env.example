# ============================================================================
# AegisFlow — Environment Configuration Template (.env.example)
# Copy this file to .env for local development.
# ============================================================================

# --- 1. PostgreSQL Database (Prisma & Vault Storage) ---
POSTGRES_USER="aegis"
POSTGRES_PASSWORD="aegis_local_pass"
POSTGRES_DB="aegis"
DATABASE_URL="postgresql://aegis:aegis_local_pass@localhost:5432/aegis?schema=public"

# --- 2. Next.js HIPAA Security Vault Keys ---
# 32-byte (64 hex chars) master key for AES-256-GCM field-level encryption (src/lib/crypto.ts)
PHI_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Shared secret for bidirectional HMAC-SHA256 webhook signing between Next.js and n8n (src/lib/hmac.ts)
AEGIS_WEBHOOK_SECRET="aegis-dev-hmac-webhook-secret-key-2026"

# API key authenticating n8n AI Agent HTTP tool calls (/api/mock/insurance & /api/mock/routing-rules)
AEGIS_TOOL_API_KEY="aegis-dev-internal-tool-api-key-2026"

# Secret used by jose to sign/verify Clinician RBAC JWT cookies & 1-click Demo Clinician sessions (ADR-006)
JWT_RBAC_SECRET="aegis-dev-clinician-rbac-jwt-secret-key-2026"

# --- 3. Self-Hosted n8n Orchestration Config (ADR-003, ADR-004, ADR-007) ---
N8N_ENCRYPTION_KEY="aegis-local-dev-n8n-encryption-key-32b"
N8N_TRIAGE_WEBHOOK_URL="http://localhost:5678/webhook/aegis-triage"
N8N_ONBOARDING_DISPATCH_WEBHOOK_URL="http://localhost:5678/webhook/aegis-onboarding-dispatch"
N8N_ONBOARDING_COMPLETE_WEBHOOK_URL="http://localhost:5678/webhook/aegis-onboarding-complete"

# When true, if n8n container is sleeping/unreachable, Next.js executes the deterministic
# local simulation loop so live portfolio reviews never fail (ADR-007)
DEMO_SIMULATE_N8N_IF_SLEEPING="true"

# Public application base URL (used to construct vault_review_url and /onboarding/[token] links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- 4. External API Integrations (Optional for Local Demo) ---
OPENAI_API_KEY="sk-proj-your-openai-key"
HUBSPOT_PRIVATE_APP_TOKEN="pat-na1-your-hubspot-sandbox-token"
RESEND_API_KEY="re_your_resend_api_key"
SLACK_CLINIC_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/X000"
